{
    "name": "woocommerce/ai-storefront",
    "description": "Merchant-led AI product syndication for WooCommerce",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Piero Rocca",
            "email": "piero.rocca@automattic.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "brain/monkey": "^2.6",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "*",
        "dealerdirect/phpcodesniffer-composer-installer": "*"
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "@php -r \"if (file_exists('bin/install-hooks.js') && trim((string) @shell_exec('node -v 2>/dev/null')) !== '') { @passthru('node bin/install-hooks.js'); }\""
        ],
        "post-update-cmd": [
            "@php -r \"if (file_exists('bin/install-hooks.js') && trim((string) @shell_exec('node -v 2>/dev/null')) !== '') { @passthru('node bin/install-hooks.js'); }\""
        ]
    },
    "autoload": {
        "classmap": [
            "includes/class-wc-ai-storefront.php",
            "includes/class-wc-ai-storefront-updater.php",
            "includes/admin/",
            "includes/ai-storefront/"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
