node_modules/
.wp-env.override.json
# Anchor `/vendor/` to the repo root so composer's top-level vendor
# dir is ignored but vendored library subdirectories (like PUC's own
# `includes/lib/plugin-update-checker/vendor/` that ships Parsedown
# for changelog rendering) are preserved. An unanchored pattern
# would silently strip those from commits.
# The plugin's runtime autoloader lives in includes/autoload.php and
# does not depend on vendor/; dev tools (PHPUnit, PHPCS, etc.) still
# use the generated vendor/ after running `composer install`.
/vendor/
.phpunit.cache/
.phpunit.result.cache
.claude/
.tools/
release-staging/

# Implementation plans are ephemeral working artifacts, not persisted docs.
# Keep them in .claude/tmp/artifacts/ (also ignored). Design specs under
# docs/superpowers/specs/ stay tracked as ADR-style rationale.
/docs/superpowers/plans/

# Local docker-compose overrides. Teammates can drop `.env` for port
# overrides (e.g. `WP_PORT=8088`) or `docker-compose.override.yml` for
# personal tweaks (xdebug, alternate PHP versions, custom mounts)
# without committing those to the shared compose file.
/.env
/docker-compose.override.yml

# Subagent-driven-development scratch (briefs, reports, review packages).
/.superpowers/
